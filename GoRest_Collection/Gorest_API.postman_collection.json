{
	"info": {
		"_postman_id": "ad80e2a4-8bda-4bb9-86dd-99b4f2550c13",
		"name": "Gorest_API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "25500307"
	},
	"item": [
		{
			"name": "Create record",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let random = Math.random().toString(36).substring(2);\r",
							"\r",
							"let name = random;\r",
							"let email = random+\"@test.com\";\r",
							"\r",
							"pm.environment.set(\"randomName\", name);\r",
							"pm.environment.set(\"randomEmail\", email)\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"pm.environment.set(\"userID\", response.id);\r",
							"\r",
							"pm.test(\"Status code is 201\", function(){\r",
							"    pm.response.to.have.status(201);\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200,201])\r",
							"});\r",
							"\r",
							"pm.test(\"Status text is created\", ()=>{\r",
							"    pm.response.to.have.status(\"Created\")\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type is present\", ()=>{\r",
							"    pm.response.to.have.header(\"Content-Type\")\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type has application/json\", function(){\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\")\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"{{randomName}}\",\r\n    \"email\":\"{{randomEmail}}\",\r\n    \"gender\":\"male\",\r\n    \"status\":\"active\"\r\n    }",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Record",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"let userID = pm.environment.get(\"userID\");\r",
							"let emailID = pm.environment.get(\"randomEmail\");\r",
							"let name = pm.environment.get(\"randomName\");\r",
							"\r",
							"pm.test(\"Status code is 200\", function(){\r",
							"    pm.response.to.have.status(200)\r",
							"});\r",
							"\r",
							"pm.test(\"Status text is OK\", function(){\r",
							"    pm.response.to.have.status(\"OK\")\r",
							"});\r",
							"\r",
							"pm.test(\"validate the response field\", function(){\r",
							"    pm.expect(response.id).to.eql(userID);\r",
							"    pm.expect(response.name).to.eql(name);\r",
							"    pm.expect(response.email).to.eql(emailID)\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}/{{userID}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					],
					"path": [
						"{{userID}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Update Record",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function(){\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201])\r",
							"})"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"{{randomName}}\",\r\n    \"email\":\"{{randomEmail}}\",\r\n    \"gender\":\"male\",\r\n    \"status\":\"inactive\"\r\n    }",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}/{{userID}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					],
					"path": [
						"{{userID}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Updated Record",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"let schema = {\r",
							"    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r",
							"    \"type\": \"object\",\r",
							"    \"properties\": {\r",
							"        \"id\": {\r",
							"            \"type\": \"integer\"\r",
							"        },\r",
							"        \"name\": {\r",
							"            \"type\": \"string\"\r",
							"        },\r",
							"        \"email\": {\r",
							"            \"type\": \"string\"\r",
							"        },\r",
							"        \"gender\": {\r",
							"            \"type\": \"string\"\r",
							"        },\r",
							"        \"status\": {\r",
							"            \"type\": \"string\"\r",
							"        }\r",
							"    },\r",
							"    \"required\": [\r",
							"        \"id\",\r",
							"        \"name\",\r",
							"        \"email\",\r",
							"        \"gender\",\r",
							"        \"status\"\r",
							"    ]\r",
							"}\r",
							"\r",
							"pm.test(\"validated json schema\", function(){\r",
							"    pm.expect(tv4.validate(response,schema)).to.be.true\r",
							"});\r",
							"\r",
							"pm.test(\"Status updated as inactive\", function(){\r",
							"    pm.expect(response.status).to.eql(\"inactive\")\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}/{{userID}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					],
					"path": [
						"{{userID}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Delete Record",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204\", function(){\r",
							"    pm.response.to.have.status(204)\r",
							"});\r",
							"\r",
							"pm.environment.unset(\"randomName\");\r",
							"pm.environment.unset(\"randomEmail\");\r",
							"pm.environment.unset(\"userID\");\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}/{{userID}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					],
					"path": [
						"{{userID}}"
					]
				}
			},
			"response": []
		}
	],
