			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "url_gorest",
			"value": "https://gorest.in",
			"type": "string"
		},
		{
			"key": "endPoint",
			"value": "/public/v2/users",
			"type": "string"
		}
	]
}