				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"pm.test(\"Status is 200\", function(){\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"OK Status Present in Reeponse\", function(){\r",
							"    pm.expect(response.status).to.eql(\"OK\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response time should be less than 1000 ms\", function(){\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
							"});\r",
							"\r",
							"pm.test(\"PlaceID is Present\", function(){\r",
							"    pm.expect(response.place_id).to.not.be.null;\r",
							"});\r",
							"\r",
							"pm.test(\"Response contains APP\", function(){\r",
							"    pm.expect(pm.response.text()).to.include(\"APP\");\r",
							"});\r",
							"\r",
							"pm.environment.set(\"place_id\", response.place_id);\r",
							"\r",
							"console.log(\"Place_ID: \"+ response.place_id);"
						],
