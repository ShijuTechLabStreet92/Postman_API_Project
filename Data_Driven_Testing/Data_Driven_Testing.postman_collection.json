{
	"info": {
		"_postman_id": "f2759e6b-2d14-41d6-86f9-5d040c34e328",
		"name": "Data_Driven_Testing",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "25500307"
	},
	"item": [
		{
			"name": "Create record",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"pm.collectionVariables.set(\"userID\", response.id);\r",
							"pm.collectionVariables.set(\"name\", response.name);\r",
							"pm.collectionVariables.set(\"email\",response.email);\r",
							"\r",
							"\r",
							"pm.test(\"Status code is 201\", function(){\r",
							"    pm.response.to.have.status(201);\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200,201])\r",
							"});\r",
							"\r",
							"pm.test(\"Status text is created\", ()=>{\r",
							"    pm.response.to.have.status(\"Created\")\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type is present\", ()=>{\r",
							"    pm.response.to.have.header(\"Content-Type\")\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type has application/json\", function(){\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\")\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"{{Name}}\",\r\n    \"email\":\"{{EmailID}}\",\r\n    \"gender\":\"male\",\r\n    \"status\":\"active\"\r\n    }",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Record",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"let userID = pm.collectionVariables.get(\"userID\");\r",
							"let name = pm.collectionVariables.get(\"name\");\r",
							"let emailID = pm.collectionVariables.get(\"email\");\r",
							"\r",
							"pm.test(\"validate the response field\", function(){\r",
							"    pm.expect(response.id).to.eql(userID);\r",
							"    pm.expect(response.name).to.eql(name);\r",
							"    pm.expect(response.email).to.eql(emailID)\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 200\", function(){\r",
							"    pm.response.to.have.status(200)\r",
							"});\r",
							"\r",
							"pm.test(\"Status text is OK\", function(){\r",
							"    pm.response.to.have.status(\"OK\")\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}/{{userID}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					],
					"path": [
						"{{userID}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Delete Record",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204\", function(){\r",
							"    pm.response.to.have.status(204)\r",
							"});\r",
							"\r",
							"pm.collectionVariables.unset(\"name\");\r",
							"pm.collectionVariables.unset(\"email\");\r",
							"pm.collectionVariables.unset(\"userID\");\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{url_gorest}}{{endPoint}}/{{userID}}",
					"host": [
						"{{url_gorest}}{{endPoint}}"
					],
					"path": [
						"{{userID}}"
					]
				}
			},
			"response": []
		}
	],
