		{
			"name": "Add Product",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.collectionVariables.set(\"product_id\", 45)"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"pm.test(\"Status code is 200 or 201\", function(){\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200,201])\r",
							"});\r",
							"\r",
							"pm.test(\"Status test is OK\", function(){\r",
							"    pm.response.to.have.status(\"OK\")\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Length is present\", ()=>{\r",
							"    pm.response.to.have.header(\"Content-Length\")\r",
							"})\r",
							"\r",
							"pm.test(\"Content-Length have 60\", function(){\r",
							"    pm.expect(pm.response.headers.get(\"Content-Length\")).to.eql(\"60\");\r",
							"})\r",
							"\r",
							"pm.test(\"Content-Type is present\", ()=>{\r",
							"    pm.response.to.have.header(\"Content-Type\")\r",
							"})\r",
							"\r",
							"pm.test(\"Content-Type is application/json\", function(){\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
							"})"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "apikey",
					"apikey": [
