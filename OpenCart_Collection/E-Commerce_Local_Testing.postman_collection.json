			"name": "Generate Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"pm.collectionVariables.set(\"api_token\", response.api_token);\r",
							"\r",
							"pm.test(\"Api Token should generate\", function(){\r",
							"    pm.expect(response.api_token).to.exist\r",
							"});\r",
							"\r",
							"pm.test(\"Status Code is 200\", function(){\r",
