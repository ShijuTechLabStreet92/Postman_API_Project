	"item": [
		{
			"name": "Create User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let randomID = Math.floor(Math.random()*100)+1;\r",
							"let randomAlpha = Math.random().toString(36).substring(2);\r",
							"\r",
							"let userName = \"user\"+randomAlpha;\r",
							"let firstName = \"F\"+randomAlpha;\r",
							"let lastName = \"L\"+randomAlpha;\r",
							"let email = randomAlpha+\"@test.com\";\r",
							"let password = randomAlpha;\r",
							"\r",
							"pm.collectionVariables.set(\"id\", randomID);\r",
							"pm.collectionVariables.set(\"userName\", userName);\r",
							"pm.collectionVariables.set(\"firstName\", firstName);\r",
							"pm.collectionVariables.set(\"lastName\", lastName);\r",
							"pm.collectionVariables.set(\"email\", email);\r",
							"pm.collectionVariables.set(\"password\", password);\r",
							"pm.collectionVariables.set(\"phone\", \"123456789\");\r",
							"pm.collectionVariables.set(\"userStatus\", 1233456);\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function(){\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201])\r",
							"})\r",
							"\r",
							"pm.test(\"Status text is OK\", function(){\r",
							"    pm.response.to.have.status(\"OK\")\r",
							"})\r",
							"\r",
							"let response = pm.response.json();\r",
							"pm.collectionVariables.set(\"postId\", response.message);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"id\": {{id}},\r\n  \"username\": \"{{userName}}\",\r\n  \"firstName\": \"{{firstName}}\",\r\n  \"lastName\": \"{{lastName}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\",\r\n  \"phone\": \"{{phone}}\",\r\n  \"userStatus\": {{userStatus}}\r\n}"
				},
				"url": {
					"raw": "{{url}}{{endPoint}}",
					"host": [
						"{{url}}{{endPoint}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"pm.test(\"postId is equal to getId\", function(){\r",
							"    pm.expect(response.id).to.eql(Number(pm.collectionVariables.get(\"postId\")))\r",
							"})\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							""
